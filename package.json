{
  "name": "aio-resource-search",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/worker",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @aio-resource-search/web",
    "dev:worker": "npm run dev --workspace @aio-resource-search/worker",
    "build": "npm run build --workspace @aio-resource-search/web && npm run typecheck --workspace @aio-resource-search/worker",
    "typecheck:worker": "npm run typecheck --workspace @aio-resource-search/worker",
    "test:worker": "npm run test --workspace @aio-resource-search/worker",
    "lint": "eslint apps/web/src apps/worker/src apps/worker/tests packages/shared/src",
    "format": "prettier --write \"apps/**/*.{ts,vue,css,json}\" \"packages/**/*.ts\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.74.0"
  },
  "type": "module"
}
