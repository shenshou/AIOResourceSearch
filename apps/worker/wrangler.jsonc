{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aio-resource-search-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  "kv_namespaces": [
    {
      "binding": "SOURCES_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
